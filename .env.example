APP_ENV=production
APP_DEBUG=false
APP_URL=http://localhost:8000

# MariaDB / MySQL Konfiguration
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=fortknox
DB_USERNAME=fortknox
DB_PASSWORD=secret

# IRC Bot Konfiguration
IRC_HOST=127.0.0.1
IRC_PORT=6697
IRC_TLS=true
IRC_NICK=PreDB-Bot
IRC_USERNAME=predb
IRC_REALNAME="FortKnox PreDB"
IRC_PASSWORD=secret
IRC_CHANNELS="#predb"

# Webhook Benachrichtigungen
WEBHOOK_ENABLED=false
WEBHOOK_URL=https://discord.com/api/webhooks/your-id/your-token
