#!/usr/bin/env php
<?php

declare(strict_types=1);

require dirname(__DIR__) . '/vendor/autoload.php';

use FortKnox\Database\Connection;
use FortKnox\IRC\AnnouncementHandler;
use FortKnox\IRC\IrcClient;
use FortKnox\IRC\IrcProtocolParser;
use FortKnox\IRC\IrcSession;
use FortKnox\Notifications\WebhookService;
use FortKnox\PreDB\ImportService;
use FortKnox\PreDB\ReleaseParser;
use FortKnox\PreDB\ReleaseRepository;

$envFile = dirname(__DIR__) . '/.env';

if (!is_readable($envFile)) {
    fwrite(STDERR, "Missing .env file.\n");
    exit(1);
}

$env = parse_ini_file($envFile);

if ($env === false) {
    fwrite(STDERR, "Unable to read .env file.\n");
    exit(1);
}

$options = getopt('', ['network-id:']);
$networkId = isset($options['network-id']) ? (int) $options['network-id'] : 1;

$connection = new Connection([
    'host' => $env['DB_HOST'] ?? '127.0.0.1',
    'port' => (int) ($env['DB_PORT'] ?? 3306),
    'database' => $env['DB_DATABASE'] ?? '',
    'username' => $env['DB_USERNAME'] ?? '',
    'password' => $env['DB_PASSWORD'] ?? '',
    'charset' => $env['DB_CHARSET'] ?? 'utf8mb4',
]);

$pdo = $connection->get();
$stmt = $pdo->prepare('SELECT * FROM irc_networks WHERE id = ? LIMIT 1');
$stmt->execute([$networkId]);
$network = $stmt->fetch(PDO::FETCH_ASSOC);

if (!$network) {
    if (empty($env['IRC_HOST'])) {
        fwrite(STDERR, "Network ID {$networkId} not found and no .env fallback available.\n");
        exit(1);
    }
    $host = (string) $env['IRC_HOST'];
    $port = (int) ($env['IRC_PORT'] ?? 6697);
    $tls = !empty($env['IRC_TLS']) && $env['IRC_TLS'] !== 'false';
    $nick = (string) ($env['IRC_NICK'] ?? 'FK-PreDB');
    $username = (string) ($env['IRC_USERNAME'] ?? 'fortknox-predb');
    $realname = (string) ($env['IRC_REALNAME'] ?? 'FortKnox PreDB');
    $password = !empty($env['IRC_PASSWORD']) ? (string) $env['IRC_PASSWORD'] : null;
    $channels = array_filter(array_map('trim', explode(',', (string) ($env['IRC_CHANNELS'] ?? '#predb'))));
} else {
    if (empty($network['is_enabled'])) {
        echo "[IRC] Network '{$network['name']}' (ID: {$networkId}) is disabled. Exiting.\n";
        exit(0);
    }
    $host = (string) $network['host'];
    $port = (int) $network['port'];
    $tls = (bool) $network['tls'];
    $nick = (string) $network['nick'];
    $username = (string) $network['username'];
    $realname = (string) $network['realname'];
    $password = !empty($network['password']) ? (string) $network['password'] : null;
    $channels = array_filter(array_map('trim', explode(',', (string) $network['channels'])));
}

$webhookUrl = (string) ($env['WEBHOOK_URL'] ?? '');
$webhookEnabled = filter_var($env['WEBHOOK_ENABLED'] ?? false, FILTER_VALIDATE_BOOLEAN);

$releaseRepository = new ReleaseRepository($pdo);
$releaseParser = new ReleaseParser();
$webhookService = new WebhookService($env);
$importService = new ImportService(
    $releaseRepository,
    $releaseParser,
    $webhookService
);

$announcementHandler = new AnnouncementHandler(
    $importService,
    $releaseParser
);

$protocolParser = new IrcProtocolParser();

$client = new IrcClient(
    $host,
    $port,
    $tls,
    $nick,
    $username,
    $realname,
    $password,
    $channels
);

$session = new IrcSession(
    $client,
    $protocolParser,
    $announcementHandler
);

echo "[IRC] Starting session for '{$nick}' on {$host}:{$port}...\n";
$session->run();
